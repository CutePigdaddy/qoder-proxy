# Qoder CN Personal Access Token (https://qoder.com.cn/account/integrations)
QODERCN_PAT=pt-your-token-here

# Client-facing API key. If left empty the gateway refuses every request (fail-closed).
PROXY_API_KEY=sk-local-change-me

PORT=3000
CONCURRENCY=3
QUEUE_LIMIT=20
# Total wall clock per request, counted from the moment it joins the queue.
# Large-context prefill alone can exceed two minutes; keep this generous.
REQUEST_TIMEOUT_MS=600000
# Upper bound for a single internal retry back-off (429 rate limit / 503 busy).
RETRY_MAX_WAIT_MS=30000
BODY_LIMIT=10485760
MODEL_FALLBACK=auto
TOKEN_CACHE_PATH=.cache/tokens.json
LOG_LEVEL=info

# Claude Code <total_tokens> markers: move (default) / strip / keep.
TOKEN_MARKER_MODE=move
# Set to 1 to log prompt-cache hash grids (forensics only, costs CPU per request).
CACHE_DIAGNOSTICS=0

# How long GET /v1/quota may serve a cached balance before calling upstream.
QODER_QUOTA_TTL_MS=60000

# Public RMB price table used to estimate cost on the dashboard.
# Mounted read-only from ./config, so editing the file + restarting the
# container is enough — no image rebuild, no price logic in code.
PRICING_CONFIG_PATH=config/pricing.json

# Model availability probing — OFF by default, and that default matters.
#
# Every probe is a real upstream request. It costs no credits, but the upstream
# counts it against a DAILY REQUEST QUOTA and starts refusing everything with
# code 110 "Billing daily count exceeded" once it is gone — including your own
# traffic, for the rest of the day (2026-10-22: 14 models every 30s burned the
# day in ~15 minutes).
#
# Each round probes every model in PROBE_MODELS (empty = the whole catalog), so
# cost = models × (86400 / PROBE_INTERVAL_MS) requests per day. Do that maths
# before enabling it. PROBE_DAILY_BUDGET is a hard stop, not a suggestion.
PROBE_ENABLED=0
PROBE_INTERVAL_MS=300000
PROBE_DAILY_BUDGET=200
# Comma-separated allow-list; empty = all models. Start with one or two.
PROBE_MODELS=

# Used only by Caddy for TLS termination
DOMAIN=localhost
