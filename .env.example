# Qoder CN Personal Access Token (https://qoder.com.cn/account/integrations)
QODERCN_PAT=pt-your-token-here

# Client-facing API key. If left empty the gateway refuses every request (fail-closed).
PROXY_API_KEY=sk-local-change-me

PORT=3000
CONCURRENCY=3
QUEUE_LIMIT=20
# Total wall clock per request, counted from the moment it joins the queue.
# Large-context prefill alone can exceed two minutes; keep this generous.
REQUEST_TIMEOUT_MS=600000
# Upper bound for a single internal retry back-off (429 rate limit / 503 busy).
RETRY_MAX_WAIT_MS=30000
BODY_LIMIT=10485760
MODEL_FALLBACK=auto
TOKEN_CACHE_PATH=.cache/tokens.json
LOG_LEVEL=info

# Claude Code <total_tokens> markers: move (default) / strip / keep.
TOKEN_MARKER_MODE=move
# Set to 1 to log prompt-cache hash grids (forensics only, costs CPU per request).
CACHE_DIAGNOSTICS=0

# How long GET /v1/quota may serve a cached balance before calling upstream.
QODER_QUOTA_TTL_MS=60000

# Public RMB price table used to estimate cost on the dashboard.
# Mounted read-only from ./config, so editing the file + restarting the
# container is enough — no image rebuild, no price logic in code.
PRICING_CONFIG_PATH=config/pricing.json

# Model availability — two modes, and the default one is free.
#
# PASSIVE (default, always on): every real request becomes one sample. Nothing
# extra is sent upstream, so it can never spend quota. The trade-off is honest:
# a model nobody uses has no data and shows "—". PROBE_WINDOW_MS is the window
# those samples are averaged over.
#
# ACTIVE (opt-in, PROBE_ENABLED=1): additionally sends a tiny "ping" per model
# on a timer, so idle models get samples too. Every probe is a real upstream
# request. It costs no credits, but the upstream counts it against a DAILY
# REQUEST QUOTA and then refuses everything with code 110 "Billing daily count
# exceeded" — including your own traffic, for the rest of the day
# (2026-10-22: 14 models every 30s burned the day in ~15 minutes).
#
# Each active round probes every model in PROBE_MODELS (empty = whole catalog),
# so cost = models × (86400 / PROBE_INTERVAL_MS) requests per day. Do that maths
# before enabling. PROBE_DAILY_BUDGET is a hard stop, not a suggestion.
PROBE_ENABLED=0
PROBE_INTERVAL_MS=300000
PROBE_WINDOW_MS=900000
PROBE_DAILY_BUDGET=200
# Comma-separated allow-list for ACTIVE probing only; empty = all models.
PROBE_MODELS=

# Client identity sent as the `Cosy-Clienttype` header.
#
# 5 (default) is the official CLI identity — this is what we actually are.
# Measured 2026-10-22: 5 is billed against credits (a zero-credit account gets
# code 112), while 1-4 reach a channel that does not consume credits. Changing
# it is a change to how this client declares itself, i.e. bypassing the
# upstream's billing decision. Leave it at 5 unless you accept that trade-off.
QODER_CLIENT_TYPE=5

# Used only by Caddy for TLS termination
DOMAIN=localhost
