{$DOMAIN:localhost} {
	# Compress ordinary responses, but never touch SSE: a compressed stream
	# makes Caddy buffer the body and the client sees nothing until the end.
	@notEventStream not header Content-Type text/event-stream
	encode @notEventStream zstd gzip

	# This gateway only serves the routes below. Internet-wide scanners spend
	# their day probing /.env, /.git/HEAD, /wp-login.php and friends; answering
	# them here keeps them out of the app and out of its logs. Add new routes
	# to this list or they will be rejected at the edge.
	#
	# `/` and `/assets/*` serve the dashboard (baked into the qoder-proxy image
	# and proxied below). `/metrics` is deliberately absent: it is unauthenticated
	# and leaks model names, request volume and remaining quota. Scrape it over
	# the compose network (http://qoder-proxy:3000/metrics) instead of the
	# public port.
	@unknown not path / /index.html /favicon.svg /icons.svg /service /health /assets/* /v1/*
	handle @unknown {
		header Content-Type application/json
		respond `{"error":{"message":"Not found","type":"invalid_request_error"}}` 404
	}

	# Vite 的资源名带内容哈希，可以永久缓存；HTML 必须每次回源校验，
	# 否则新版本发布后浏览器还拿着旧哈希指向已删除的 chunk。
	# 这条链路跨境只有几 KB/s，重复下载 200KB 脚本就是「打开很慢」的主因。
	@assetFile path /assets/*
	header @assetFile Cache-Control "public, max-age=31536000, immutable"

	@document path / /index.html
	header @document Cache-Control "no-cache"

	reverse_proxy qoder-proxy:3000 {
		# Disable response buffering so SSE chunks reach the client immediately.
		flush_interval -1
	}
}
